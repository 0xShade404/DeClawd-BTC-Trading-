# ==============================================================================
# DeClawd - Environment Configuration
# Copy this file to .env (root) and/or apps/api/.env, apps/web/.env.local
# NEVER commit real secrets. Use a secret manager (Vault, AWS Secrets Manager,
# Doppler, etc.) in production.
# ==============================================================================

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Database ----------
# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://declawd:declawd@localhost:5432/declawd?schema=public

# ---------- Cache / Queues ----------
REDIS_URL=redis://localhost:6379

# ---------- API Server ----------
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ---------- Auth: JWT ----------
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-a-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=replace-with-a-32-byte-random-secret

# ---------- Auth: Google OAuth ----------
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ---------- Blockchain / Wallet ----------
# Polygon RPC endpoint (Alchemy, Infura, QuickNode, or self-hosted)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137
USDC_CONTRACT_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# WalletConnect Cloud project id: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------- Polymarket Integration ----------
# Polymarket CLOB API credentials. Trading is signed client-side by the
# user's wallet; these are used server-side only for market data / order
# relaying where the API requires it. See packages/trading-engine/src/providers/polymarket.
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---------- Market Data / News Sentiment ----------
# Optional third-party feeds used by the AI probability module.
BTC_PRICE_FEED_URL=https://api.coingecko.com/api/v3
NEWS_SENTIMENT_API_KEY=

# ---------- Notifications ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DeClawd <no-reply@declawd.app>"

TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Web push (VAPID keys: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- Trading Engine ----------
TRADING_CYCLE_CRON="*/15 * * * *"
TRADING_ENGINE_ENABLED=false
PROFIT_VAULT_ALLOCATION_PCT=70
PROFIT_TRADING_POOL_ALLOCATION_PCT=30

# ---------- Frontend (public, safe to expose) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development
